# API manzili.
# Prodda bo'sh qoldiring — nginx /api/ ni backendga uzatadi va so'rovlar
# shu domenga ketadi. Lokal ishlab chiqishda backend manzilini yozing.
VITE_API_URL=http://localhost:8000

# Faqat lokal sinov uchun: qurilmadan nusxa olingan initData satri.
# Telegram ichida ochilganda bu qiymat ishlatilmaydi.
# Olish yo'li: Mini App ni telefonda oching, DevTools da
# window.Telegram.WebApp.initData ni nusxa qiling.
VITE_DEV_INIT_DATA=
