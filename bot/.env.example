# @BotFather bergan token
BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# PostgreSQL ulanish manzili (asyncpg drayveri bilan)
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/davomat_db

# SuperAdmin Telegram ID raqami (@userinfobot orqali bilib olish mumkin)
SUPERADMIN_ID=123456789

# Hisobotlar yuboriladigan kanal ID si.
# Bu taklif havolasi EMAS, balki -100 bilan boshlanadigan raqam bo'lishi kerak.
# Botni kanalga admin qilib qo'shing, keyin @username_to_id_bot orqali ID ni oling.
CHANNEL_ID=-1001234567890

# Ixtiyoriy: FSM holatini Redisda saqlash (bot qayta ishga tushganda
# to'ldirilayotgan hisobot yo'qolmaydi). Bo'sh qoldirilsa xotira ishlatiladi.
REDIS_URL=

# Ixtiyoriy: bazada parol bo'lmasa, birinchi ishga tushishda shu parol o'rnatiladi.
# Bo'sh qoldirilsa tasodifiy parol yaratiladi va logga bir marta yoziladi.
INITIAL_ACCESS_PASSWORD=

# Ixtiyoriy: DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO
