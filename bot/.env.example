# @BotFather bergan token
BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# PostgreSQL ulanish manzili (asyncpg drayveri bilan)
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/davomat_db

# SuperAdmin Telegram ID raqami (@userinfobot orqali bilib olish mumkin)
SUPERADMIN_ID=123456789

# Hisobotlar yuboriladigan kanal ID si.
# Bu taklif havolasi EMAS, balki -100 bilan boshlanadigan raqam bo'lishi kerak.
# Botni kanalga admin qilib qo'shing, keyin @username_to_id_bot orqali ID ni oling.
CHANNEL_ID=-1001234567890

# Ixtiyoriy: FSM holatini Redisda saqlash (bot qayta ishga tushganda
# to'ldirilayotgan hisobot yo'qolmaydi). Bo'sh qoldirilsa xotira ishlatiladi.
REDIS_URL=

# Ixtiyoriy: bazada parol bo'lmasa, birinchi ishga tushishda shu parol o'rnatiladi.
# Bo'sh qoldirilsa tasodifiy parol yaratiladi va logga bir marta yoziladi.
INITIAL_ACCESS_PASSWORD=

# Ixtiyoriy: DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO

# ─── Mini App API ───────────────────────────────────────────────────────────

# API qaysi manzilda tinglaydi. Oldida nginx tursa 127.0.0.1 qoldiring.
API_HOST=127.0.0.1
API_PORT=8000

# Mini App ochiladigan HTTPS manzil. Shu manzil @BotFather da ham
# ko'rsatiladi (/newapp yoki Bot Settings -> Menu Button).
WEBAPP_URL=https://davomat.example.uz

# Mini App yuklagan rasmlar avval shu yopiq chatga yuboriladi va Telegram
# file_id qaytaradi. Yopiq kanal yarating, botni unga admin qilib qo'shing.
STORAGE_CHAT_ID=-1009876543210

# initData necha soniya haqiqiy hisoblanadi (standart: 3600)
INITDATA_TTL_SECONDS=3600

# Faqat lokal ishlab chiqish uchun, vergul bilan ajratiladi.
# Prodda bo'sh qoldiring — Mini App Telegram ichida ochiladi.
CORS_ORIGINS=
